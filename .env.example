# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real secrets.

# From `cat config/master.key` (Windows: `type config\master.key`)
RAILS_MASTER_KEY=

# Postgres credentials, shared by the db and web services in docker-compose.yml
POSTGRES_DB=pdf_on_rails_production
POSTGRES_USER=pdf_on_rails
POSTGRES_PASSWORD=

# From the Cloudflare Zero Trust dashboard: Networks > Tunnels > your tunnel > Install connector
CLOUDFLARE_TUNNEL_TOKEN=
