# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real secrets.

# From `cat config/master.key` (Windows: `type config\master.key`)
RAILS_MASTER_KEY=

# Postgres credentials, shared by the db and web services in docker-compose.yml
POSTGRES_DB=pdf_on_rails_production
POSTGRES_USER=pdf_on_rails
POSTGRES_PASSWORD=

# No Cloudflare account/token needed - cloudflared runs in "quick tunnel" mode
# and prints a random public URL to its own logs on every start.
