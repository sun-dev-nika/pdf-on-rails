<section class="py-24 text-center">
  <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
    Your PDFs, sorted. No signup required.
  </h1>
  <p class="mx-auto mt-4 max-w-xl text-lg text-slate-600">
    Merge, split, rotate, compress, and convert your files right in the browser.
    Upload, process, download — that's it.
  </p>
  <div class="mt-8 flex items-center justify-center gap-4">
    <% if user_signed_in? %>
      <span class="text-slate-600">Signed in as <%= current_user.email %></span>
    <% else %>
      <%= link_to "Get started", new_user_registration_path, class: "rounded-md bg-slate-900 px-5 py-2.5 text-white hover:bg-slate-700" %>
      <span class="text-sm text-slate-500">or just start uploading, no account needed</span>
    <% end %>
  </div>
  <p class="mx-auto mt-10 max-w-md text-xs text-slate-400">
    Files are processed on our server and automatically deleted shortly after.
  </p>
</section>
