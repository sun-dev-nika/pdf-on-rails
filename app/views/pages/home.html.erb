<section class="py-16 text-center">
  <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
    <%= t("pages.home.headline") %>
  </h1>
  <p class="mx-auto mt-4 max-w-xl text-lg text-slate-600">
    <%= t("pages.home.subheadline") %>
  </p>
  <div class="mt-8 flex items-center justify-center gap-4">
    <% if user_signed_in? %>
      <span class="text-slate-600"><%= t("pages.home.signed_in_as", email: current_user.email) %></span>
    <% else %>
      <%= link_to t("pages.home.get_started"), new_user_registration_path, class: "rounded-md bg-slate-900 px-5 py-2.5 text-white hover:bg-slate-700" %>
      <span class="text-sm text-slate-500"><%= t("pages.home.no_account_needed") %></span>
    <% end %>
  </div>
</section>

<section class="mx-auto grid max-w-4xl grid-cols-2 gap-4 pb-16 sm:grid-cols-5">
  <% [
       [merge_path, t("pdf_operations.nav.merge")],
       [split_path, t("pdf_operations.nav.split")],
       [rotate_path, t("pdf_operations.nav.rotate")],
       [delete_pages_path, t("pdf_operations.nav.delete_pages")],
       [organize_path, t("pdf_operations.nav.organize")],
       [compress_path, t("pdf_operations.nav.compress")],
       [watermark_path, t("pdf_operations.nav.watermark")],
       [protect_path, t("pdf_operations.nav.protect")],
       [unlock_path, t("pdf_operations.nav.unlock")],
       [jpg_to_pdf_path, t("conversions.nav.jpg_to_pdf")],
       [pdf_to_jpg_path, t("conversions.nav.pdf_to_jpg")],
       [ocr_path, t("pdf_operations.nav.ocr")],
       [office_to_pdf_path, t("conversions.nav.office_to_pdf")],
     ].each do |path, label| %>
    <%= link_to path, class: "rounded-xl border border-slate-200 px-4 py-6 text-center hover:border-slate-400 hover:bg-slate-50" do %>
      <span class="block text-sm font-medium text-slate-900"><%= label %></span>
    <% end %>
  <% end %>
</section>

<p class="mx-auto max-w-md pb-16 text-center text-xs text-slate-400">
  <%= t("pages.home.privacy_note") %>
</p>
