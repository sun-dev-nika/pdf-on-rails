<section class="py-24 text-center">
  <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
    <%= t("pages.home.headline") %>
  </h1>
  <p class="mx-auto mt-4 max-w-xl text-lg text-slate-600">
    <%= t("pages.home.subheadline") %>
  </p>
  <div class="mt-8 flex items-center justify-center gap-4">
    <% if user_signed_in? %>
      <span class="text-slate-600"><%= t("pages.home.signed_in_as", email: current_user.email) %></span>
    <% else %>
      <%= link_to t("pages.home.get_started"), new_user_registration_path, class: "rounded-md bg-slate-900 px-5 py-2.5 text-white hover:bg-slate-700" %>
      <span class="text-sm text-slate-500"><%= t("pages.home.no_account_needed") %></span>
    <% end %>
  </div>
  <p class="mx-auto mt-10 max-w-md text-xs text-slate-400">
    <%= t("pages.home.privacy_note") %>
  </p>
</section>
