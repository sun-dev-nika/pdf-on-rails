<% content_for :title, t("conversions.pdf_to_jpg.title") %>

<section class="py-12">
  <h1 class="text-3xl font-bold tracking-tight"><%= t("conversions.pdf_to_jpg.title") %></h1>
  <p class="mt-2 text-slate-600"><%= t("conversions.pdf_to_jpg.description") %></p>

  <%# turbo: false - avoids Turbo intercepting this file-download form (see pdf_operations/merge.html.erb). %>
  <%= form_with url: pdf_to_jpg_path, method: :post, multipart: true, data: { turbo: false }, class: "mt-8 max-w-xl" do %>
    <%= render "shared/upload_zone", name: "pdf", multiple: false, sortable: false %>
    <%= submit_tag t("conversions.pdf_to_jpg.submit"), class: "mt-6 w-full cursor-pointer rounded-md bg-slate-900 px-5 py-2.5 text-white hover:bg-slate-700" %>
  <% end %>
</section>
