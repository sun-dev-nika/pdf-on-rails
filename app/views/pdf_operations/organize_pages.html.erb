<% content_for :title, t("pdf_operations.organize.title") %>

<section class="py-12" data-controller="page-reorder">
  <h1 class="text-3xl font-bold tracking-tight"><%= t("pdf_operations.organize.title") %></h1>
  <p class="mt-2 text-slate-600"><%= t("pdf_operations.organize.thumbnails_hint") %></p>

  <ul data-page-reorder-target="grid" class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
    <% @thumbnails.each_with_index do |thumbnail_base64, index| %>
      <li
        draggable="true"
        data-page="<%= index + 1 %>"
        data-action="dragstart->page-reorder#dragStart dragover->page-reorder#dragOver drop->page-reorder#drop"
        class="cursor-move rounded-lg border border-slate-200 bg-white p-2"
      >
        <img src="data:image/jpeg;base64,<%= thumbnail_base64 %>" class="pointer-events-none w-full rounded" alt="">
        <span class="pointer-events-none mt-1 block text-center text-xs text-slate-500"><%= index + 1 %></span>
      </li>
    <% end %>
  </ul>

  <%= form_with url: organize_apply_path(@processed_file), method: :patch, class: "mt-8 max-w-xl" do %>
    <%= hidden_field_tag :order, (1..@thumbnails.size).to_a.join(","), data: { page_reorder_target: "orderInput" } %>
    <%= submit_tag t("pdf_operations.organize.confirm"), class: "w-full cursor-pointer rounded-md bg-slate-900 px-5 py-2.5 text-white hover:bg-slate-700" %>
  <% end %>
</section>
