<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "Pdf on Rails" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Pdf on Rails">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-white text-slate-900">
    <header class="border-b border-slate-200">
      <div class="container mx-auto flex items-center justify-between px-5 py-4">
        <%= link_to "Pdf on Rails", root_path, class: "text-lg font-semibold tracking-tight" %>
        <nav class="flex items-center gap-4 text-sm">
          <div class="flex items-center gap-1 text-slate-400">
            <%= link_to "ES", url_for(params.to_unsafe_h.merge(locale: "es")), class: "hover:text-slate-900 #{"font-semibold text-slate-900" if I18n.locale == :es}" %>
            <span>·</span>
            <%= link_to "EN", url_for(params.to_unsafe_h.merge(locale: "en")), class: "hover:text-slate-900 #{"font-semibold text-slate-900" if I18n.locale == :en}" %>
          </div>
          <% if user_signed_in? %>
            <%= button_to t("layout.sign_out"), destroy_user_session_path, method: :delete, class: "text-slate-600 hover:text-slate-900" %>
          <% else %>
            <%= link_to t("layout.sign_in"), new_user_session_path, class: "text-slate-600 hover:text-slate-900" %>
            <%= link_to t("layout.sign_up"), new_user_registration_path, class: "rounded-md bg-slate-900 px-3 py-1.5 text-white hover:bg-slate-700" %>
          <% end %>
        </nav>
      </div>
    </header>

    <% if notice %>
      <p class="container mx-auto mt-4 px-5"><span class="block rounded-md bg-emerald-50 px-4 py-2 text-sm text-emerald-800"><%= notice %></span></p>
    <% end %>
    <% if alert %>
      <p class="container mx-auto mt-4 px-5"><span class="block rounded-md bg-rose-50 px-4 py-2 text-sm text-rose-800"><%= alert %></span></p>
    <% end %>

    <main class="container mx-auto px-5">
      <%= yield %>
    </main>
  </body>
</html>
